## Kconfig fragment: Fedora base config -> Qubes-suitable kernel.
##
## Merge over a Fedora .config with scripts/kconfig/merge_config.sh, then run
## `make olddefconfig`.  Lines beginning with '##' are comments and must be
## stripped before merging (scripts/fetch-config.sh does this for you), because
## merge_config.sh treats '#' lines as "is not set" directives.
##
## Modelled on config-qubes from QubesOS/qubes-linux-kernel.  Grouped by why the
## setting exists, so you can drop the groups you do not want.  Values marked
## [Fedora already] are what Fedora sets anyway and are listed only so the file
## is a complete statement of intent.


################################################################################
## GROUP 1 -- required to boot and function as a qube.
## Fedora already enables all of these.  They are asserted here so that a
## `localmodconfig`, a defconfig, or a hand-edited config cannot quietly drop
## one and leave you with a kernel that hangs at "Waiting for /dev/xvda*".

## Xen guest core.  XEN_PVH is what Qubes' default virt_mode=pvh needs: it puts
## the XEN_ELFNOTE_PHYS32_ENTRY note in the image so Xen can enter it directly.
CONFIG_HYPERVISOR_GUEST=y
CONFIG_PARAVIRT=y
CONFIG_PARAVIRT_XXL=y
CONFIG_XEN=y
CONFIG_XEN_PVH=y
CONFIG_XEN_PV=y
CONFIG_XEN_PVHVM=y

## Console.  The default cmdline says console=hvc0; without these the qube boots
## blind and `qvm-console-dispvm` shows nothing.
CONFIG_HVC_XEN=y
CONFIG_HVC_XEN_FRONTEND=y

## Block and network frontends.  Fedora builds blkfront as a module, which is
## why the initramfs must carry it (qubes-prepare-vm-kernel forces it in).
CONFIG_XEN_XENBUS_FRONTEND=y
CONFIG_XEN_BLKDEV_FRONTEND=m
CONFIG_XEN_NETDEV_FRONTEND=m

## vchan: the transport under qrexec, qubesdb, the GUI, clipboard and file copy.
## A qube missing these boots and is then unreachable.
CONFIG_XEN_DEV_EVTCHN=m
CONFIG_XEN_GNTDEV=m
CONFIG_XEN_GRANT_DEV_ALLOC=m
CONFIG_XEN_PRIVCMD=m
CONFIG_XENFS=m
CONFIG_XEN_COMPAT_XENFS=y
CONFIG_XEN_SYS_HYPERVISOR=y

## PCI passthrough frontend -- sys-net and sys-usb are useless without it.
CONFIG_XEN_PCIDEV_FRONTEND=m

## What the qubes-vm-simple initramfs needs to assemble the root filesystem:
## a dm-snapshot over a read-only root, ext4, and an overlay for /lib/modules.
CONFIG_BLK_DEV_DM=y
CONFIG_DM_SNAPSHOT=y
CONFIG_EXT4_FS=y
## overlayfs may be a module: the initramfs tries `modprobe overlay` and falls
## back to bind-mounting just the `uname -r` subdirectory if it is unavailable.
## Fedora ships =m and so does Qubes; =y only removes the fallback path.
CONFIG_OVERLAY_FS=m

## Ballooning.  Qubes' memory manager moves memory between qubes at runtime;
## the hotplug variant lets a qube grow past its boot-time allocation and avoids
## burning usable address space on grant tables.
CONFIG_XEN_BALLOON=y
CONFIG_XEN_BALLOON_MEMORY_HOTPLUG=y
CONFIG_XEN_UNPOPULATED_ALLOC=y


################################################################################
## GROUP 2 -- real deltas from Fedora that Qubes needs.
## These are the settings where Fedora's answer is wrong for Qubes.

## Turn grant references into dma-bufs and back.  Required by the Qubes GUI
## daemon for the shared-framebuffer path.  Fedora leaves GRANT_DMA_ALLOC off.
CONFIG_XEN_GRANT_DMA_ALLOC=y
CONFIG_XEN_GNTDEV_DMABUF=y

## Qubes does not use virtio devices under Xen, and CONFIG_XEN_VIRTIO under PV
## behaves as FORCE_GRANT, which breaks running Xen nested inside KVM.
# CONFIG_XEN_VIRTIO is not set

## Xen PV guests legitimately have some W+X pages; the warning is noise.
# CONFIG_DEBUG_WX is not set

## Fedora's /usr/bin/modprobe assumes a merged-/sbin layout.  Qubes supports
## systems where it is not merged.
CONFIG_MODPROBE_PATH="/sbin/modprobe"

## Expose the running config.  This is how you inspect what a qube is actually
## booting -- see docs/02-building.md 2.4.
CONFIG_IKCONFIG=y
CONFIG_IKCONFIG_PROC=y

## Whonix uses AppArmor; Fedora ships SELinux and Qubes does not enable it by
## default in VMs.
CONFIG_SECURITY_APPARMOR=y
# CONFIG_DEFAULT_SECURITY_SELINUX is not set
CONFIG_DEFAULT_SECURITY_DAC=y
CONFIG_LSM="landlock,yama,loadpin,safesetid,integrity"


################################################################################
## GROUP 3 -- dom0 / host-side.  Harmless in a VM kernel; Qubes builds one
## kernel for both roles.  Skip this group for a VM-only kernel if you like.

CONFIG_XEN_DOM0=y
CONFIG_XEN_PV_DOM0=y
CONFIG_XEN_BACKEND=y
CONFIG_XEN_BLKDEV_BACKEND=m
CONFIG_XEN_NETDEV_BACKEND=m
CONFIG_XEN_PCIDEV_BACKEND=m
CONFIG_XEN_PCI_STUB=y
CONFIG_PCI_XEN=y
CONFIG_XEN_ACPI_PROCESSOR=m
CONFIG_XEN_EFI=y

## Long dm-thin and dm-crypt operations in dom0 make the whole desktop stutter
## without preemption -- a parallel kernel build is enough to trigger it.
CONFIG_PREEMPT=y

## Disable PCI hotplug: it is an avenue for DMA attacks through ExpressCard and
## Thunderbolt ports.  QubesOS/qubes-issues#1673
# CONFIG_HOTPLUG_PCI is not set

## USB host controllers as modules, so a PCI device can be bound to pciback
## before a driver claims it.
CONFIG_USB_UHCI_HCD=m
CONFIG_USB_OHCI_HCD=m
CONFIG_USB_EHCI_HCD=m
CONFIG_USB_XHCI_HCD=m

## Avoid a kernel/EfiACPIMemoryNVS conflict seen on some AMD Threadripper boards.
CONFIG_PHYSICAL_START=0x200000
CONFIG_PHYSICAL_ALIGN=0x200000

## AMD XDNA needs PASID, which Xen exposes to no guest, and breaks boot under Xen.
# CONFIG_DRM_ACCEL_AMDXDNA is not set


################################################################################
## GROUP 4 -- Qubes hardening and policy.  None of this is needed to boot.
## Drop the group for a debugging kernel; keep it to match what Qubes ships.

CONFIG_EXPERT=y

## More ASLR entropy than Fedora's default.
CONFIG_ARCH_MMAP_RND_BITS=32
CONFIG_ARCH_MMAP_RND_COMPAT_BITS=16

## Attack surface that a Qubes guest has no use for.
# CONFIG_KEXEC is not set
# CONFIG_CRASH_DUMP is not set
# CONFIG_HIBERNATION is not set
# CONFIG_PROC_KCORE is not set
CONFIG_LEGACY_VSYSCALL_NONE=y
CONFIG_SECURITY_DMESG_RESTRICT=y

CONFIG_INIT_ON_ALLOC_DEFAULT_ON=y
CONFIG_INIT_ON_FREE_DEFAULT_ON=y
CONFIG_INIT_STACK_ALL_ZERO=y
CONFIG_GCC_PLUGINS=y
CONFIG_GCC_PLUGIN_LATENT_ENTROPY=y
CONFIG_STACKPROTECTOR=y
CONFIG_STACKPROTECTOR_STRONG=y
CONFIG_SCHED_STACK_END_CHECK=y
CONFIG_IO_STRICT_DEVMEM=y
CONFIG_SECURITY_YAMA=y

## Fail loudly rather than limp on.  PANIC_TIMEOUT=-1 means do not auto-reboot,
## so the console log survives for you to read.
CONFIG_PANIC_ON_OOPS=y
CONFIG_PANIC_TIMEOUT=-1

CONFIG_INTEL_IOMMU_DEFAULT_ON=y

## xz keeps /boot small; Qubes keeps several kernels installed at once.
CONFIG_KERNEL_XZ=y
# CONFIG_KERNEL_GZIP is not set
# CONFIG_KERNEL_ZSTD is not set
